[Unit]
Description=Chemistry Frontend (Next.js, port 3000)
After=network.target

[Service]
Type=simple
EnvironmentFile=/www/chemistry.env
WorkingDirectory=/www/wwwroot/current/frontend
# 不用 pnpm start（有兼容问题），直接 node 跑 next 二进制
ExecStart=${NODE_BIN} /www/wwwroot/current/frontend/node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
