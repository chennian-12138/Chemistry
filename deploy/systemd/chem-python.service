[Unit]
Description=Chemistry RDKit Python Service (FastAPI, port 5000)
After=network.target postgresql.service

[Service]
Type=simple
EnvironmentFile=/www/chemistry.env
WorkingDirectory=/www/wwwroot/current/backend/python_service
# venv 外置在 /www/venvs/chem-python，换版本目录不受影响
ExecStart=/www/venvs/chem-python/bin/python -m uvicorn app:app --host 127.0.0.1 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
