# ===== 后端环境变量模板 =====
# 复制成 .env.development(本机) 或 .env.production(服务器) 后填入真实值。
# 本文件不含任何秘钥，可提交到 git。

# 数据库连接串
DATABASE_URL="postgresql://用户:密码@主机:5432/chemistry?schema=public"

# Better Auth（SECRET 用 `openssl rand -base64 32` 生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# 服务地址
PYTHON_URL=http://localhost:5000
RDKIT_PYTHON_PATH=python3

# GitHub OAuth（https://github.com/settings/developers）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 邮件发信（QQ 邮箱：设置→账户→开启 SMTP 服务，获取 16 位授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的SMTP授权码
EMAIL_FROM=你的QQ邮箱@qq.com

# 大模型（DeepSeek，OpenAI 兼容协议；换 provider 只改这三项）
LLM_API_KEY=你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com
# 主对话模型，推荐 deepseek-v4-flash（便宜快速，支持思维链开关）
LLM_MODEL=deepseek-v4-flash
# 标题/追问生成用的轻量模型
LLM_TITLE_MODEL=deepseek-v4-flash
# 每个用户每天的对话轮数上限
CHAT_DAILY_LIMIT=25
