# ===== 后端环境变量模板 =====
# 复制成 .env.development(本机) 或 .env.production(服务器) 后填入真实值。
# 本文件不含任何秘钥，可提交到 git。

# 数据库连接串
DATABASE_URL="postgresql://用户:密码@主机:5432/chemistry?schema=public"

# Better Auth（SECRET 用 `openssl rand -base64 32` 生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# 服务地址
PYTHON_URL=http://localhost:5000
RDKIT_PYTHON_PATH=python3

# GitHub OAuth（https://github.com/settings/developers）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 邮件发信（QQ 邮箱：设置→账户→开启 SMTP 服务，获取 16 位授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的SMTP授权码
EMAIL_FROM=你的QQ邮箱@qq.com
